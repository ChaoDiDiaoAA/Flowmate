{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": [
      "bun",
      "node",
      "vite/client"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/**/*.d.ts",
    "electron.vite.config.ts",
    "agent-eval/src/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "agent-eval/tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
