+          params.subagent_type !== 'invoice-evidence-checker' ||
+          (params.run_in_background !== undefined && params.run_in_background !== false) ||
+          typeof params.prompt !== 'string' || !params.prompt.trim() || Buffer.byteLength(params.prompt) > 65000 ||
+          typeof params.description !== 'string' || !params.description.trim() || Buffer.byteLength(params.description) > 512)
+          throw new Error('subagent_parameters_invalid');
+        if (signal?.aborted) throw new Error('agent_cancelled');
+        const control = input.controlForCall(toolCallId);
+        if (control.role.name !== params.subagent_type || control.role.extensions !== false || control.role.skills !== false ||
+          control.role.memory || control.role.persistSession || control.role.outputTranscript || control.role.runInBackground ||
+          (control.role.allowedSubagents !== undefined && (control.role.allowedSubagents === 'all' || control.role.allowedSubagents.length > 0)))
+          throw new Error('subagent_role_invalid');
+        const { state, callbacks } = createActivityTracker();
+        const { record } = await manager.spawnAndWait(pi, ctx, params.subagent_type, params.prompt, {
+          description: params.description, signal, managed: control, ...callbacks,
+        });
+        const base = { displayName: control.role.displayName ?? control.role.name, description: params.description,
+          subagentType: params.subagent_type, modelName: record.invocation?.modelName, tags: undefined };
+        const details = buildDetails(base, record, state);
+        return foregroundAgentResult(record, details, '', false);
+      },
+    }));
+  };
+}
+
+function foregroundAgentResult(record: AgentRecord, details: AgentDetails, fallbackNote: string, showCost: boolean) {
+  if (record.status === 'error')
+    return textResult(`${fallbackNote}Agent failed: ${record.error}${partialOutputSuffix(record)}`, details);
+  const durationMs = (record.completedAt ?? Date.now()) - record.startedAt;
+  const statsParts = [`${record.toolUses} tool uses`];
+  const tokenText = formatLifetimeTokens(record);
+  if (tokenText) statsParts.push(tokenText);
+  if (showCost) {
+    const costText = formatCost(getLifetimeCost(record.lifetimeUsage));
+    if (costText) statsParts.push(costText);
+  }
+  return textResult(
+    `${fallbackNote}Agent completed in ${formatMs(durationMs)} (${statsParts.join(', ')})${getForegroundOutcomeNote(record.status)}.\n\n` +
+      (record.result?.trim() || 'No output.'), details);
+}
