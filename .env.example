# Optional Langfuse backend; local evaluation requires none of these credentials.
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="http://localhost:3000"

# Optional platform attribution (default flowmate-eval).
FLOWMATE_EVAL_USER_ID=""
# Actual trace environment for optional export; also saved locally.
FLOWMATE_EVAL_ENVIRONMENT="development"
# Optional display version. When empty, the evaluator records the current Git commit.
FLOWMATE_EVAL_RELEASE=""

# Product Provider. Keep the API key local; it is never written to Case,
# Langfuse, SQLite, logs, or a command argument.
# BASE_URL is the provider API root, for example https://api.example.com/v1.
FLOWMATE_LLM_BASE_URL=""
FLOWMATE_LLM_MODEL=""
FLOWMATE_LLM_API_KEY=""
# Optional Pi API protocol. Defaults to openai-completions.
# Supported: openai-completions | openai-responses | anthropic-messages | google-generative-ai
FLOWMATE_LLM_API="openai-completions"
# Independent local Judge. No Agent or platform credential inheritance.
# PROVIDER: anthropic | openai-compatible. BASE_URL is API root, e.g. https://example.com/v1.
FLOWMATE_JUDGE_PROVIDER=""
FLOWMATE_JUDGE_MODEL=""
FLOWMATE_JUDGE_BASE_URL=""
FLOWMATE_JUDGE_API_KEY=""
FLOWMATE_JUDGE_TEMPERATURE="0.8"
FLOWMATE_JUDGE_MAX_TOKENS="256"
FLOWMATE_JUDGE_TIMEOUT_MS="30000"
FLOWMATE_EVAL_BACKEND="local"
