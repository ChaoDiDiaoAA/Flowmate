# Copy to .env for local development. Do not commit the copied file.
# Bun loads this file for `bun run` commands; the desktop startup also loads
# the explicit project file before selecting its configuration.
FLOWMATE_DESKTOP_CONFIG=

# Optional key referenced by config/pi-models.example.json.
# Keep the real value in the local .env or use a Pi auth.json file instead.
FLOWMATE_LLM_API_KEY=
