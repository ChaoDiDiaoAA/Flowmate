{
  "name": "flowmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev --config apps/desktop/electron.vite.config.ts",
    "build": "bun run typecheck && electron-vite build --config apps/desktop/electron.vite.config.ts",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:runtime": "vitest run tests/runtime",
    "test:desktop": "bun run build && playwright test --config playwright.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "eval:smoke": "vitest run agent-eval/tests",
    "eval:p0": "tsx agent-eval/src/cli.ts",
    "doctor": "tsx scripts/doctor.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "verify:runtime-lock": "tsx scripts/verify-runtime-lock.ts",
    "verify:handoff": "tsx scripts/verify-handoff.ts",
    "p0": "tsx scripts/p0.ts",
    "prepare:subagent": "tsx scripts/prepare-subagent.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@playwright/test": "1.63.0",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
