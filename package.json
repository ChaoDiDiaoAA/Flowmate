{
  "name": "flowmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*",
    "apps/*",
    "agent-eval"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build:desktop": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun --no-env-file run scripts/test.ts unit",
    "test:integration": "bun --no-env-file run scripts/test.ts integration",
    "test:e2e": "bun --no-env-file run scripts/test.ts e2e",
    "test": "bun --no-env-file run scripts/test.ts all",
    "cli": "bun run apps/cli/main.ts",
    "eval": "node --import tsx agent-eval/src/cli.ts",
    "eval:smoke": "node --import tsx agent-eval/src/cli.ts run --dataset flowmate-agent-v1 --selection smoke --judge off",
    "eval:full": "node --import tsx agent-eval/src/cli.ts run --dataset flowmate-agent-v1 --selection full --judge required"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@flowmate/contracts": "workspace:*",
    "@flowmate/core": "workspace:*",
    "@flowmate/logging": "workspace:*",
    "@flowmate/runtime-pi": "workspace:*",
    "@flowmate/shared": "workspace:*",
    "proper-lockfile": "4.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.4.5",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "7.1.10"
  }
}
