{
  "sourceRoot": "D:/paper/Invoice",
  "roleMap": {
    "sourceId": "voxel51-invoice-ocr",
    "parserVersion": "mineru@3.4.5",
    "encoding": "utf8",
    "sampleIdRegex": "(?:^|/)voxel51/(?<sampleId>[^/]+)/(?:original|content|pages|fields)\\.[^/]+$",
    "roles": {
      "original": { "patterns": ["voxel51/*/original.{pdf,jpg,jpeg,png}"] },
      "parsed": { "patterns": ["voxel51/*/content.json"] },
      "metadata": { "patterns": ["voxel51/*/pages.json"] },
      "labels": { "patterns": ["voxel51/*/fields.json"] }
    }
  }
}
