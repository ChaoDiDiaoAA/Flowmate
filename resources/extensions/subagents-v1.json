{
  "schemaVersion": 2,
  "kind": "extension",
  "id": "subagents",
  "version": "v1",
  "sdkVersion": "0.85.1",
  "entryId": "pi-subagents-managed-v1",
  "pluginVersion": "0.19.0",
  "patchVersion": "flowmate-p13.2",
  "tools": [
    {
      "name": "Agent",
      "version": "0.19.0-p13.2"
    }
  ],
  "commands": [
    "subagent"
  ],
  "hooks": [
    {
      "event": "session_start",
      "policy": "critical"
    },
    {
      "event": "tool_call",
      "policy": "critical"
    },
    {
      "event": "tool_result",
      "policy": "observer"
    },
    {
      "event": "tool_execution_end",
      "policy": "observer"
    },
    {
      "event": "session_shutdown",
      "policy": "critical"
    }
  ]
}
